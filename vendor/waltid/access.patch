+package id.walt.webdatafetching.engines
+
+import io.ktor.client.*
+import io.ktor.client.engine.mock.*
+import io.ktor.client.request.*
+import io.ktor.http.*
+import kotlinx.coroutines.test.runTest
+import kotlin.test.*
+
+class CredspanAccessTest {
+    @Test
+    fun `service credentials stay on the exact HTTPS origin and redirects are not followed`() = runTest {
+        val sent = mutableListOf<HttpRequestData>()
+        val engine = MockEngine { request ->
+            sent.add(request)
+            respond("", HttpStatusCode.Found, headersOf(HttpHeaders.Location, "https://elsewhere.test/redirect"))
+        }
+        val client = HttpClient(engine) { installCredspanAccess(this, "https://credspan-sandbox.m1ngshum.com", "synthetic-id", "synthetic-secret") }
+        try {
+            val urls = listOf("https://credspan-sandbox.m1ngshum.com/issuer/x", "https://credspan-sandbox.m1ngshum.com:444/x", "http://credspan-sandbox.m1ngshum.com/x", "https://credspan-sandbox.m1ngshum.com.evil.test/x", "https://elsewhere.test/x")
+            for (url in urls) client.get(url)
+            assertEquals(urls.size, sent.size)
+            assertEquals("synthetic-id", sent[0].headers["CF-Access-Client-Id"])
+            assertEquals("synthetic-secret", sent[0].headers["CF-Access-Client-Secret"])
+            for (request in sent.drop(1)) { assertNull(request.headers["CF-Access-Client-Id"]); assertNull(request.headers["CF-Access-Client-Secret"]) }
+            installCredspanAccess(HttpClientConfig<MockEngineConfig>(), null, null, null)
+            assertFailsWith<IllegalArgumentException> { installCredspanAccess(HttpClientConfig<MockEngineConfig>(), null, "id", "secret") }
+            assertFailsWith<IllegalArgumentException> { installCredspanAccess(HttpClientConfig<MockEngineConfig>(), "https://evil.test", "id", "secret") }
+            assertFailsWith<IllegalArgumentException> { installCredspanAccess(HttpClientConfig<MockEngineConfig>(), "https://credspan-sandbox.m1ngshum.com", "id", "bad\nsecret") }
+        } finally { client.close() }
+    }
+}
