+package id.walt.webdatafetching.engines
+
+import io.ktor.client.*
+import io.ktor.client.plugins.api.*
+import io.ktor.client.plugins.logging.*
+import io.ktor.http.*
+
+internal fun installCredspanAccess(
+    config: HttpClientConfig<*>,
+    origin: String? = System.getenv("CREDSPAN_ACCESS_ORIGIN"),
+    clientId: String? = System.getenv("CF_ACCESS_CLIENT_ID"),
+    secret: String? = System.getenv("CF_ACCESS_CLIENT_SECRET"),
+) {
+    if (origin == null) {
+        require(clientId == null && secret == null) { "Access requires an explicit origin" }
+        return
+    }
+    require(origin == "https://credspan-sandbox.m1ngshum.com") { "Invalid Access origin" }
+    require(listOf(clientId, secret).all { it != null && it.isNotBlank() && it.length <= 4096 && !it.contains('\r') && !it.contains('\n') }) { "Invalid Access credentials" }
+    val access = createClientPlugin("CredspanAccess") {
+        onRequest { request, _ ->
+            request.headers.remove("CF-Access-Client-Id")
+            request.headers.remove("CF-Access-Client-Secret")
+            val target = request.url.build()
+            if (target.protocol == URLProtocol.HTTPS && target.host == "credspan-sandbox.m1ngshum.com" && target.port == 443 && target.user.isNullOrEmpty() && target.password.isNullOrEmpty()) {
+                request.headers.append("CF-Access-Client-Id", clientId!!)
+                request.headers.append("CF-Access-Client-Secret", secret!!)
+            }
+        }
+    }
+    config.apply {
+        followRedirects = false
+        install(Logging) { level = LogLevel.NONE }
+        install(access)
+    }
+}
