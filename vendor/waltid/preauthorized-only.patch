+    @Test
+    fun `preauthorized only metadata may omit response types and round trips`() {
+        val metadata = json.decodeFromString<AuthorizationServerMetadata>(
+            """{"issuer":"https://as.example","token_endpoint":"https://as.example/token","grant_types_supported":["urn:ietf:params:oauth:grant-type:pre-authorized_code"]}"""
+        )
+        assertEquals(null, metadata.responseTypesSupported)
+        val withChallenge = metadata.copy(challengeEndpoint = "https://as.example/challenge")
+        assertEquals(withChallenge, json.decodeFromString<AuthorizationServerMetadata>(json.encodeToString(withChallenge)))
+        assertFailsWith<IllegalArgumentException> { metadata.copy(grantTypesSupported = null) }
+        assertFailsWith<IllegalArgumentException> { metadata.copy(grantTypesSupported = setOf("authorization_code")) }
+        assertFailsWith<IllegalArgumentException> { metadata.copy(responseTypesSupported = emptySet()) }
+        val encoded = json.encodeToString(metadata)
+        assertFalse("response_types_supported" in json.parseToJsonElement(encoded).jsonObject)
+        assertEquals(metadata, json.decodeFromString<AuthorizationServerMetadata>(encoded))
+    }
+
