{
  "name": "@credspan/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm build && node --test dist/tests/unit.test.js",
    "start": "node dist/src/main.js",
    "test:integration": "pnpm build && node --test --test-concurrency=1 dist/tests/integration.test.js",
    "test:storage": "pnpm build && node --test dist/tests/storage.test.js",
    "export:openapi": "tsc -p tsconfig.export.json && node dist/src/export-openapi.js",
    "test:browser": "pnpm build && node --test dist/tests/browser.test.js"
  },
  "dependencies": {
    "@credo-ts/core": "0.7.4",
    "@credo-ts/node": "0.7.4",
    "@credo-ts/askar": "0.7.4",
    "@credo-ts/openid4vc": "0.7.4",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "express": "5.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@openwallet-foundation/askar-nodejs": "0.6.1",
    "@openwallet-foundation/askar-shared": "0.6.1",
    "@openid4vc/oauth2": "0.6.0",
    "@nestjs/swagger": "12.1.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "jose": "6.2.17",
    "@playwright/test": "1.65.0",
    "@axe-core/playwright": "4.14.0",
    "@credspan/sdk": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "files": [
    "dist/src",
    "package.json"
  ]
}
