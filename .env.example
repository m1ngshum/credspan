# Copy to .env and replace every placeholder. Only synthetic local data is supported.
CREDSPAN_SANDBOX=<set-to-1>
CONTROL_DIRECTORY=<absolute-private-control-directory>
PUBLIC_URL=<http://localhost:3000>
HOST=<127.0.0.1>
PORT=<3000>
MANAGEMENT_API_KEY=<random-at-least-32-characters>
ASKAR_STORE_ID=<credspan_sandbox>
ASKAR_STORE_KEY=<different-random-at-least-32-characters>
POSTGRES_HOST=<127.0.0.1:5432>
POSTGRES_USER=<credspan>
POSTGRES_PASSWORD=<random-local-database-password>

# Optional: omit to trust only this store issuer; set JSON [] to deny all. Local managed cohort only.
# TRUSTED_ISSUER_DIDS=<JSON-array-of-did:key-identifiers>
